# --- Telegram ---
# From @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Comma-separated Telegram user ids seeded as SUPER ADMIN on every startup.
# This is the only way a super admin is created -- the bot cannot mint one.
# Required: with this empty, nobody can administer the bot.
SUPER_ADMIN_IDS=

# --- Database ---
# Local dev (default):
DATABASE_URL=sqlite+aiosqlite:///./powerbank.db
# Production:
# DATABASE_URL=postgresql+asyncpg://powerbank:CHANGEME@localhost:5432/powerbank
DB_ECHO=false

# --- Runtime ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
